# ==================================================
# OSDrone-AI Configuration
# Copiez ce fichier vers .env et adaptez les valeurs
# ==================================================

# Sécurité API
API_KEY=CHANGE_ME_WITH_A_LONG_RANDOM_KEY

# Logs
LOG_LEVEL=INFO

# Fuseau horaire
TZ=Europe/Paris

# Rate limiting
RATE_LIMIT=600/minute

# WebSocket
WEBSOCKET_ENABLED=true

# Futures options
# API_KEY_PREVIOUS=
# ALLOWED_ORIGINS=*
